# ─── Doma Volume Bot Configuration ───
# Copy this file to .env and fill in YOUR values.
# Never commit your .env to git!

# ─── Wallet (REQUIRED) ────────────────────────────────────────────────
# Use a NEW dedicated wallet — never reuse your main wallet.
# Either set MNEMONIC (recommended) or raw PRIVATE_KEY.
MNEMONIC=
MNEMONIC_ACCOUNT_INDEX=0
PRIVATE_KEY=

# ─── Network ──────────────────────────────────────────────────────────
RPC_URL=https://doma.drpc.org
RPC_BACKUP=https://rpc.doma.xyz
CHAIN_ID=97477

# ─── Doma V3 contracts (already filled, leave as-is) ──────────────────
USDCE_ADDRESS=0x31EEf89D5215C305304a2fA5376a1f1b6C5dc477
UNIVERSAL_ROUTER=0x5089863E97196773038f98459262D866f2281f58

# ─── YOUR DOMAIN TOKEN (REQUIRED) ─────────────────────────────────────
# Find these on https://doma.xyz/explore by clicking your token's pool.
TOKEN_ADDRESS=
TOKEN_SYMBOL=YOURTOKEN
POOL_ADDRESS=

# Pool fee tier (Uniswap V3 units):
#   100 = 0.01%
#   500 = 0.05%   (most Doma tokens use this)
#   3000 = 0.30%
#   10000 = 1.00%
POOL_FEE=500

# Token decimals (most Doma launchpad tokens are 6)
TOKEN_DECIMALS=6
USDCE_DECIMALS=6

# ─── Volume strategy ──────────────────────────────────────────────────
# Random jitter on size and interval makes activity look natural.

# Per-swap USD size (bot picks a random value between min and max)
SWAP_SIZE_USD_MIN=5
SWAP_SIZE_USD_MAX=25

# Seconds between swaps (random jitter)
SWAP_INTERVAL_SEC_MIN=60
SWAP_INTERVAL_SEC_MAX=300

# Slippage tolerance per swap
MAX_SLIPPAGE_PCT=0.005

# ─── Safety guards ────────────────────────────────────────────────────
# Bot HALTS for the day if cumulative loss exceeds this.
# Example: at 0.05% pool, $10 swaps × 100 = $1000 volume = $1 loss
# A $5/day budget = ~500 swaps/day = ~$5000 daily volume
DAILY_LOSS_BUDGET_USD=5

# Don't swap if pool TVL is below this (avoids dead pools)
MIN_POOL_TVL_USD=5000

# Don't swap more than this % of pool TVL per swap
MAX_SWAP_PCT_OF_TVL=0.005

# Skip swap if estimated price impact exceeds this (basis points)
MAX_SWAP_IMPACT_BPS=50

# ─── Mode ─────────────────────────────────────────────────────────────
# Set DRY_RUN=true for testing (logs what it would do, no real txs).
# Set DRY_RUN=false to actually trade.
DRY_RUN=true

LOG_LEVEL=INFO
